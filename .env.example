# ═══════════════════════════════════════════════════════════════════
# Universidad X — Variables de entorno (.env.example)
# Copia este archivo a .env y rellena los valores reales.
# NUNCA commitear .env con valores reales (.gitignore ya lo excluye).
# En un VPS (docker-compose.staging.yml) las variables de los bloques marcados
# [OBLIGATORIO] no tienen default: si faltan, `docker compose` se niega a arrancar.
# Guía: docs/06-despliegue.md · Generar secretos: openssl rand -base64 48
# ═══════════════════════════════════════════════════════════════════

# ── Base de datos [OBLIGATORIO] ──────────────────────────────────────
# Los *_PORT solo aplican en desarrollo (en VPS las bases no publican puertos).
POSTGRES_DB=universidadx
POSTGRES_USER=ux_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

MONGO_DB=universidadx
MONGO_USER=ux_admin
MONGO_PASSWORD=CHANGE_ME
MONGO_PORT=27017

REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

# ── Secretos JWT [OBLIGATORIO] (mínimo 32 caracteres, distintos entre sí) ──
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_REQUIRED_HERE
JWT_REFRESH_SECRET=CHANGE_ME_OTHER_32_CHARS_REQUIRED_HERE

# ── Web (NextAuth.js) [OBLIGATORIO] ───────────────────────────────────
# NEXTAUTH_URL = URL pública de la web (https://… en VPS); también fija ALLOWED_ORIGINS.
NEXTAUTH_SECRET=CHANGE_ME_MIN_32_CHARS_REQUIRED_HERE
NEXTAUTH_URL=http://localhost:3000
WEB_PORT=3000

# ── URLs públicas vistas por el navegador ─────────────────────────────
AUTH_EXTERNAL_URL=http://localhost:4001
MEDIA_EXTERNAL_URL=http://localhost:4008
MEDIA_PORT=4008

# ── pgAdmin / Mongo Express (en VPS solo con --profile tools, en 127.0.0.1) ──
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME
PGADMIN_PORT=5050
ME_USER=admin
ME_PASSWORD=CHANGE_ME
ME_PORT=8082

# ── Credenciales (Open Badges) ────────────────────────────────────────
ISSUER_URL=https://universidadx.com
ISSUER_NAME=Universidad X

# ── Email ─────────────────────────────────────────────────────────────
# SMTP_HOST=console (o vacío) escribe los correos en el log (no envía). Para envío real,
# p. ej. SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASS=<api key>.
SMTP_HOST=console
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Universidad X <noreply@universidadx.com>"

# ── SSO (opcional; vacío = deshabilitado) ─────────────────────────────
# SAML (auth-service)
SSO_ENTRY_POINT=
SSO_ISSUER=universidad-x
SSO_CERT=
SSO_CALLBACK_URL=
# OIDC (web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# ── Firebase Cloud Messaging (reservado: el backend aún no envía push) ──
FCM_SERVER_KEY=

# ── Imágenes (solo docker-compose.staging.yml) ────────────────────────
REGISTRY=ghcr.io/universidad-x
IMAGE_TAG=latest
